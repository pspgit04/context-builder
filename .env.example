# Wazuh API gateway (not the Manager API)
WAZUH_GATEWAY_URL=http://wazuh-vm-gateway.wazuh-gateway.svc.cluster.local:8080
WAZUH_GATEWAY_INTERNAL_TOKEN=replace-with-wazuh-gateway-token

# Kubernetes API list endpoint for Trivy Operator VulnerabilityReport resources.
# Use HTTPS if supplying a service-account bearer token.
TRIVY_REPORTS_URL=http://10.10.4.9:8001/apis/aquasecurity.github.io/v1alpha1/vulnerabilityreports
TRIVY_API_BEARER_TOKEN=
TRIVY_API_VERIFY_TLS=true

# Context Builder service
CONTEXT_BUILDER_INTERNAL_TOKEN=replace-with-a-different-long-random-secret
CONTEXT_BUILDER_HOST=0.0.0.0
CONTEXT_BUILDER_PORT=8090
CONTEXT_BUILDER_TIMEOUT_SECONDS=10.0
